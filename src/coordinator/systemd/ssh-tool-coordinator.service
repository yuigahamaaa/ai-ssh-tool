[Unit]
Description=SSH Tool remote coordination service
After=local-fs.target

[Service]
Type=simple
User=ssh-tool-coordinator
Group=ssh-tool-coordinator
ExecStart=/opt/ssh-tool-coordinator/current/server-main.js
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ssh-tool-coordinator/data /run/ssh-tool-coordinator
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
